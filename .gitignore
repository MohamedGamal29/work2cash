# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma

# Local environment files
.env
.env.*
!.env.example

# SQLite database files
*.db
*.db-journal
*.sqlite
*.sqlite3

# AI coding assistant generated files
.agents/
.claude/
.windsurf/
skills-lock.json
# Allow safe environment templates in Git
!.env.example
!.env.local.example
# Keep only the latest reviewed extraction evaluation report
test-results/*.csv
