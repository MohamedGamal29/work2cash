DATABASE_URL="file:./dev.db"
APPROVAL_SIGNING_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Gemini API
GEMINI_API_KEY=

# PayPal Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_INVOICER_EMAIL=
PAYPAL_TEST_CUSTOMER_EMAIL=

# Shared hackathon demo access
DEMO_USERNAME=judge
DEMO_PASSWORD=replace-with-a-random-secret-of-at-least-24-characters

# PayPal webhooks (optional): enables payment events in the proof chain
# Create a Sandbox webhook for INVOICING.INVOICE.* events and paste its ID.
PAYPAL_WEBHOOK_ID=
# Local testing only; ignored when NODE_ENV=production
# PAYPAL_WEBHOOK_SKIP_VERIFY=true